{
  "$schema": "http://json-schema.org/schema",
  "$id": "SharedLib",
  "title": "Gerar Shared Library",
  "description": "Cria uma lib compartilhada em libs/shared/<name> com tags, tsconfig e jest configurados.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da lib (ex: utils, types, testing)",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Qual o nome da lib shared?"
    },
    "description": {
      "type": "string",
      "description": "Descrição curta da lib",
      "default": ""
    },
    "stack": {
      "type": "string",
      "description": "Runtime/framework alvo da lib",
      "enum": ["node", "react", "angular", "universal"],
      "default": "node",
      "x-prompt": {
        "message": "Qual a stack da lib?",
        "type": "list",
        "items": [
          { "value": "node", "label": "Node.js" },
          { "value": "react", "label": "React / Next.js" },
          { "value": "angular", "label": "Angular" },
          { "value": "universal", "label": "Universal (sem dependência de runtime)" }
        ]
      }
    }
  },
  "required": ["name"]
}
