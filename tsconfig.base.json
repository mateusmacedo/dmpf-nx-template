{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "ignoreDeprecations": "6.0",
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@lidercap-apps/shared-utils": ["libs/shared/utils/src/index.ts"],
      "@lidercap-apps/shared-types": ["libs/shared/types/src/index.ts"]
    }
  }
}
